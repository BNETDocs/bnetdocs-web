<?php /* vim: set colorcolumn= expandtab shiftwidth=2 softtabstop=2 tabstop=4 smarttab: */
namespace BNETDocs\Templates\User;

use \BNETDocs\Libraries\Comment;
use \BNETDocs\Libraries\Core\UrlFormatter;
use \BNETDocs\Libraries\User\User;

$active_user = $this->getContext()->active_user;
$documents = $this->getContext()->documents ?? [];
$news_posts = $this->getContext()->news_posts ?? [];
$packets = $this->getContext()->packets ?? [];
$servers = $this->getContext()->servers ?? [];
$comments = $this->getContext()->comments ?? [];
$user = $this->getContext()->user;
$user_id = $this->getContext()->user_id;
$user_profile = $this->getContext()->user_profile;
$title = ($user ? $user->getName() : 'User Not Found');
$description = ($user ? $user->getName() . '\'s user profile on BNETDocs' : 'The requested user does not exist or could not be found.');
$url = ($user ? $user->getURI() : UrlFormatter::format('/user/' . rawurlencode($user_id ?? '')));
$_header_meta_properties = ['og:type' => 'profile'];
$_header_stylesheets = ['user-profile.css'];

$e = fn(?string $value): string => filter_var($value ?? '', FILTER_SANITIZE_FULL_SPECIAL_CHARS);

// Number of items in a list shown before the remainder is tucked behind a "Show all" toggle.
$list_preview = 12;
$comment_preview = 5;

if ($user)
{
  $_header_meta_properties['og:profile:username'] = $user->getUsername();
  $_header_meta_properties['og:image'] = $user->getAvatarURI(null);

  $is_self = ($active_user && $active_user->getId() === $user->getId());
  $can_modify = ($active_user && $active_user->getOption(User::OPTION_ACL_USER_MODIFY));
  $can_edit_comments = ($active_user && $active_user->getOption(User::OPTION_ACL_COMMENT_MODIFY));
  $can_delete_comments = ($active_user && $active_user->getOption(User::OPTION_ACL_COMMENT_DELETE));
  $viewer_is_staff = ($active_user && $active_user->isStaff());

  $tags = $user->getTags();
  $user_created_dt = $user->getCreatedDateTime();
  $user_display_name = $user->getDisplayName();
  $user_verified = $user->isVerified();
  $user_verified_dt = $user->getVerifiedDateTime();

  $biography = $user_profile ? trim($user_profile->getBiography() ?? '') : '';
  if (!empty($biography)) $description = $biography;

  // Social and contact links: [service, display value, href or null]
  $links = [];
  if ($user_profile)
  {
    $website = $user_profile->getWebsite();
    $candidates = [
      ['Discord', $user_profile->getDiscordUsername(), null],
      ['GitHub', $user_profile->getGitHubUsername(), $user_profile->getGitHubURI()],
      ['Reddit', $user_profile->getRedditUsername(), $user_profile->getRedditURI()],
      ['Steam', $user_profile->getSteamId(), $user_profile->getSteamURI()],
      ['Twitter', $user_profile->getTwitterUsername(), $user_profile->getTwitterURI()],
      ['Facebook', $user_profile->getFacebookUsername(), $user_profile->getFacebookURI()],
      ['Instagram', $user_profile->getInstagramUsername(), $user_profile->getInstagramURI()],
      ['Skype', $user_profile->getSkypeUsername(), $user_profile->getSkypeURI()],
      ['Website', empty($website) ? null : preg_replace('#^https?://|/$#i', '', $website), $website],
    ];
    foreach ($candidates as $candidate)
    {
      if (is_string($candidate[1]) && $candidate[1] !== '') $links[] = $candidate;
    }
  }

  // Contribution tiles; counts reflect what is actually listed (unpublished items are hidden).
  $stats = [
    ['documents', 'Documents', count($documents)],
    ['packets', 'Packets', count($packets)],
    ['news', 'News posts', count($news_posts)],
    ['servers', 'Servers', count($servers)],
    ['comments', 'Comments', count($comments)],
  ];
  $stats = array_values(array_filter($stats, fn(array $stat): bool => $stat[2] > 0));
}

/**
 * Renders a grid of linked items, collapsing anything past $list_preview behind a toggle.
 *
 * @param array $items Objects to render.
 * @param string $noun Plural noun for the toggle label.
 * @param callable $render Returns [title html, subtitle html, href] for an item.
 */
$render_grid = function (array $items, string $noun, callable $render) use ($list_preview): void
{
  $items = array_values($items);
  $chunks = [array_slice($items, 0, $list_preview), array_slice($items, $list_preview)];
  foreach ($chunks as $i => $chunk)
  {
    if (empty($chunk)) continue;
    if ($i === 1) printf('<details class="profile-more"><summary>Show all %d %s</summary>' . PHP_EOL, count($items), $noun);
    echo '<ul class="profile-grid">' . PHP_EOL;
    foreach ($chunk as $item)
    {
      [$item_title, $item_sub, $item_href] = $render($item);
      printf('<li><a href="%s"><span class="profile-item-title">%s</span>%s</a></li>' . PHP_EOL,
        $item_href, $item_title, ($item_sub ? sprintf('<span class="profile-item-sub">%s</span>', $item_sub) : '')
      );
    }
    echo '</ul>' . PHP_EOL;
    if ($i === 1) echo '</details>' . PHP_EOL;
  }
};

$short_date = fn(?\DateTimeInterface $dt): string => $dt ? sprintf(
  '<time datetime="%s" data-localize="false">%s</time>', $dt->format('c'), $dt->format('M j, Y')
) : '';

$parent_labels = [
  Comment::PARENT_TYPE_COMMENT => 'a comment',
  Comment::PARENT_TYPE_DOCUMENT => 'a document',
  Comment::PARENT_TYPE_NEWS_POST => 'a news post',
  Comment::PARENT_TYPE_PACKET => 'a packet',
  Comment::PARENT_TYPE_SERVER => 'a server',
  Comment::PARENT_TYPE_USER => 'a user',
];

require('./Includes/header.inc.phtml'); ?>
<div class="container">
<? if (!$user) { ?>
  <div class="alert alert-danger">
    <h1 class="h2"><?=$title?></h1>
    <p class="mb-0"><?=$description?></p>
  </div>
<? } else { ?>
  <section class="profile-hero mb-3" aria-label="User profile">
    <div class="profile-hero-body">
      <img class="profile-avatar" src="<?=$user->getAvatarURI(128)?>" srcset="<?=$user->getAvatarURI(256)?> 2x" width="128" height="128" alt="<?=$e($user->getName())?>'s avatar"/>
      <div class="profile-identity">
        <h1 class="profile-name"><?=$e($user->getName())?>
<?  if ($user->isStaff()) { ?>
          <span class="badge badge-info ml-1" title="BNETDocs staff member">Staff</span>
<?  } ?>
<?  if ($user->isDisabled()) { ?>
          <span class="badge badge-danger ml-1" title="This account is disabled">Disabled</span>
<?  } ?>
        </h1>
        <div class="profile-meta">
<?  if (!empty($user_display_name) && $user_display_name !== $user->getUsername()) { ?>
          <span>@<?=$e($user->getUsername())?></span>
<?  } ?>
          <span title="<?=$user_created_dt->format('D M j, Y')?>">Member for <?=$e($user->getCreatedEstimate())?></span>
          <span>User #<?=$e((string) $user->getId())?></span>
        </div>
<?  if (!empty($biography)) { ?>
        <p class="profile-bio"><?=$e($biography)?></p>
<?  } else if ($is_self) { ?>
        <p class="profile-bio text-muted"><em>You haven't written a biography yet.</em> <a href="<?=UrlFormatter::format('/user/update')?>">Add one</a></p>
<?  } ?>
<?  if (!empty($links)) { ?>
        <ul class="profile-links">
<?    foreach ($links as [$service, $value, $href]) { ?>
          <li class="profile-link-<?=strtolower($service)?>"><span class="profile-link-service"><?=$service?></span>
<?      if ($href) { ?>
            <a class="profile-link-value" rel="external nofollow" href="<?=$e($href)?>"><?=$e($value)?></a></li>
<?      } else { ?>
            <span class="profile-link-value text-light"><?=$e($value)?></span></li>
<?      } ?>
<?    } ?>
        </ul>
<?  } ?>
<?  if (!empty($tags)) { ?>
        <div class="mt-3"><? require('./Includes/TagDisplay.inc.phtml'); ?></div>
<?  } ?>
      </div>
<?  if ($is_self || $can_modify) { ?>
      <div class="profile-actions">
<?    if ($is_self) { ?>
        <a class="btn btn-sm btn-secondary" href="<?=UrlFormatter::format('/user/update')?>">📝 Edit profile</a>
        <a class="btn btn-sm btn-secondary" href="<?=UrlFormatter::format('/user/changepassword')?>">🔑 Change password</a>
<?    } ?>
<?    if ($can_modify) { ?>
        <a class="btn btn-sm btn-secondary" href="<?=UrlFormatter::format('/user/edit?id=' . rawurlencode($user->getId()))?>">🛡️ Edit user</a>
<?    } ?>
      </div>
<?  } ?>
    </div>
<?  if (!empty($stats)) { ?>
    <nav class="profile-stats" aria-label="Contributions">
<?    foreach ($stats as [$anchor, $label, $count]) { ?>
      <a class="profile-stat" href="#<?=$anchor?>"><span class="profile-stat-value"><?=number_format($count)?></span><span class="profile-stat-label"><?=$label?></span></a>
<?    } ?>
    </nav>
<?  } else { ?>
    <div class="profile-empty"><?=($is_self ? 'You haven\'t contributed yet. Comments, documents, and packets you write will show up here.' : $e($user->getName()) . ' hasn\'t contributed anything yet.')?></div>
<?  } ?>
<?  if ($viewer_is_staff) { ?>
    <details class="profile-staff">
      <summary>Account details (staff only)</summary>
      <dl>
        <dt>Created</dt><dd><time datetime="<?=$user_created_dt->format('c')?>"><?=$user_created_dt->format('D M j, Y g:ia T')?></time></dd>
        <dt>Verified</dt><dd class="<?=($user_verified ? '' : 'text-danger')?>"><?=($user_verified && $user_verified_dt ? sprintf('<time datetime="%s">%s</time>', $user_verified_dt->format('c'), $user_verified_dt->format('D M j, Y g:ia T')) : '<em>not verified</em>')?></dd>
        <dt>Record updated</dt><dd><time datetime="<?=$user->getRecordUpdated()->format('c')?>"><?=$user->getRecordUpdated()->format('D M j, Y g:ia T')?></time></dd>
      </dl>
    </details>
<?  } ?>
  </section>

<?  if (!empty($documents)) { ?>
  <section class="profile-section" id="documents">
    <h2 class="profile-section-title">Documents <span class="badge badge-secondary"><?=number_format(count($documents))?></span></h2>
<?    $render_grid($documents, 'documents', fn($d) => [$e($d->getTitle()), $short_date($d->getPublishedDateTime()), $d->getURI()]); ?>
  </section>
<?  } ?>

<?  if (!empty($packets)) { ?>
  <section class="profile-section" id="packets">
    <h2 class="profile-section-title">Packets <span class="badge badge-secondary"><?=number_format(count($packets))?></span></h2>
<?    $render_grid($packets, 'packets', fn($p) => [
        '<code>' . $e($p->getName()) . '</code>',
        sprintf('%s &middot; %s', $e($p->getPacketId(true)), $e($p->getDirectionLabel())),
        $p->getURI(),
      ]); ?>
  </section>
<?  } ?>

<?  if (!empty($news_posts)) { ?>
  <section class="profile-section" id="news">
    <h2 class="profile-section-title">News posts <span class="badge badge-secondary"><?=number_format(count($news_posts))?></span></h2>
<?    $render_grid($news_posts, 'news posts', fn($n) => [$e($n->getTitle()), $short_date($n->getPublishedDateTime()), $n->getURI()]); ?>
  </section>
<?  } ?>

<?  if (!empty($servers)) { ?>
  <section class="profile-section" id="servers">
    <h2 class="profile-section-title">Servers <span class="badge badge-secondary"><?=number_format(count($servers))?></span></h2>
<?    $render_grid($servers, 'servers', fn($s) => [
        $e($s->getName()),
        '<code>' . $e($s->getAddress() . ':' . $s->getPort()) . '</code>',
        $s->getURI(),
      ]); ?>
  </section>
<?  } ?>

<?  if (!empty($comments)) { ?>
  <section class="profile-section" id="comments">
    <h2 class="profile-section-title">Comments <span class="badge badge-secondary"><?=number_format(count($comments))?></span></h2>
<?    foreach (array_values($comments) as $i => $c) {
        $c_id = rawurlencode((string) $c->getId());
        $c_dt = $c->getCreatedDateTime();
        $c_own = ($active_user && $c->getUserId() === $active_user->getId());
        if ($i === $comment_preview) printf('<details class="profile-more"><summary>Show %d older comments</summary>' . PHP_EOL, count($comments) - $comment_preview); ?>
    <article class="profile-comment">
      <div class="profile-comment-meta">
        <span>On <a href="<?=$c->getParentUrl()?>"><?=($parent_labels[$c->getParentType()] ?? 'a page')?></a></span>
        <span>&middot;</span>
        <time datetime="<?=$c_dt->format('c')?>"><?=$c_dt->format('D M j, Y g:ia T')?></time>
<?      if ($c_own || $can_edit_comments || $can_delete_comments) { ?>
        <span class="profile-comment-actions">
<?        if ($c_own || $can_edit_comments) { ?>
          <a class="btn btn-sm btn-secondary" href="<?=UrlFormatter::format('/comment/edit?id=' . $c_id)?>" title="Edit">📝</a>
<?        } ?>
<?        if ($c_own || $can_delete_comments) { ?>
          <a class="btn btn-sm btn-danger" href="<?=UrlFormatter::format('/comment/delete?id=' . $c_id)?>" title="Delete">❌</a>
<?        } ?>
        </span>
<?      } ?>
      </div>
<?      $c_raw = $c->getContent(false);
        $c_long = (strlen($c_raw) > 800 || substr_count($c_raw, "\n") > 10);
        if ($c_long) { ?>
      <input type="checkbox" class="profile-clamp-toggle sr-only" id="comment-<?=$c_id?>-more"/>
<?      } ?>
      <div class="profile-comment-body<?=($c_long ? ' profile-clamp' : '')?>"><?=$c->getContent(true)?></div>
<?      if ($c_long) { ?>
      <label class="profile-clamp-label" for="comment-<?=$c_id?>-more"></label>
<?      } ?>
    </article>
<?    }
      if (count($comments) > $comment_preview) echo '</details>' . PHP_EOL; ?>
  </section>
<?  } ?>
<? } ?>
</div>
<? require('./Includes/footer.inc.phtml'); ?>
