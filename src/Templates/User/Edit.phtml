  $messages = $field_errors[$field] ?? $field_errors['profile'];
  return sprintf('<div class="invalid-feedback d-block">%s</div>', $messages[$code] ?? ('Internal error: ' . $code));
};
$field_invalid = fn(string $field): string => isset($model->errors[$field]) ? ' is-invalid' : '';
$esc = fn(?string $v): string => filter_var($v ?? '', FILTER_SANITIZE_FULL_SPECIAL_CHARS);
$options = $model->options;
$editable = $model->editable_mask;
$checkbox = function(int $bit, string $id, string $label, string $label_class = '') use ($options, $editable): string {
  $disabled = !($editable & $bit);
  return sprintf(
    '<div class="custom-control custom-checkbox"%s>'
    . '<input type="checkbox" class="custom-control-input" id="%s" name="options[]" value="%d" data-bit="%d"%s%s/>'
    . '<label class="custom-control-label%s" for="%s">%s</label></div>',
    $disabled ? ' title="You cannot change this permission"' : '',
    $id, $bit, $bit,
    ($options & $bit) ? ' checked' : '',
    $disabled ? ' disabled' : '',
    $label_class ? ' ' . $label_class : '', $id, $label
  );
};
