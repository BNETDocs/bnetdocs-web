  </form>
  <script type="text/javascript">
  (function() {
    var form = document.getElementById('user_edit_form');
    var boxes = form.querySelectorAll('input[name="options[]"]');
    var before = <?=(int) $model->options_before?>;
    var hidden = before & ~<?=(int) EditModel::KNOWN_MASK?>;
    var aclMask = <?=(int) EditModel::ACL_MASK?>;
    // presets need this script, so they are only shown when it runs
    document.getElementById('permission_presets').hidden = false;
    document.getElementById('permission_presets_note').hidden = false;
    function hex(v) { return '0x' + ('00000000' + v.toString(16).toUpperCase()).slice(-8); }
    function update() {
      var v = hidden;
      boxes.forEach(function(b) { if (b.checked) v |= parseInt(b.dataset.bit, 10); });
      document.getElementById('options_after').textContent = hex(v);
      document.getElementById('options_change').classList.toggle('d-none', v === before);
    }
    form.querySelectorAll('[data-preset]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var preset = parseInt(btn.dataset.preset, 10);
        boxes.forEach(function(b) {
          var bit = parseInt(b.dataset.bit, 10);
          if (!b.disabled && (bit & aclMask)) b.checked = !!(preset & bit);
        });
        dirty = true;
        update();
      });
    });
    boxes.forEach(function(b) { b.addEventListener('change', update); });
    var dirty = false;
    form.addEventListener('input', function() { dirty = true; });
    form.addEventListener('change', function() { dirty = true; });
    document.getElementById('resend_verification_form').addEventListener('submit', function(e) {
      if (dirty && !window.confirm('You have unsaved changes on this page, which will be lost. Send the verification email anyway?')) e.preventDefault();
    });
    update();
  })();
  </script>
