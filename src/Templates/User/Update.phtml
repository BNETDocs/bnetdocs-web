    <div class="text-center mb-4">
      <a class="btn btn-secondary" href="<?=$user->getURI()?>">Cancel</a>
      <input class="btn btn-success" type="submit" value="Save Profile"/>
    </div>
  </form>
  <script type="text/javascript">
  (function() {
    // the confirmation field is only needed, and only shown, once the email address is changed
    var email = document.getElementById('email');
    var group = document.getElementById('email_confirm_group');
    var confirm = document.getElementById('email_confirm');
    function update() {
      var changed = email.value.trim().toLowerCase() !== email.dataset.original.toLowerCase();
      group.classList.toggle('d-none', !changed);
      confirm.required = changed;
    }
    email.addEventListener('input', update);
    update();
  })();
  </script>
<? } ?>
</div>
