    'COOLDOWN' => 'A verification email was sent to you a moment ago. Wait a couple of minutes before changing your email address again.',
  ],
  'email_confirm' => [
    'MISMATCH' => 'The email addresses do not match, check for typos.',
  ],
  'profile' => [
    'TOO_LONG' => sprintf('Must be at most %d characters.', $model->profile_max_len),
  ],
];
$field_error = function(string $field) use ($model, $field_errors): string {
  $code = $model->errors[$field] ?? null;
  if (is_null($code)) return '';
  $messages = $field_errors[$field] ?? $field_errors['profile'];
  return sprintf('<div class="invalid-feedback d-block">%s</div>', $messages[$code] ?? ('Internal error: ' . $code));
};
$field_invalid = fn(string $field): string => isset($model->errors[$field]) ? ' is-invalid' : '';
$input_class = 'border border-primary form-control bg-dark text-light';
require('./Includes/header.inc.phtml'); ?>
<div class="container">
