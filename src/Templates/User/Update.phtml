      <div class="text-muted small">Signed in as <?=$esc($user->getUsername())?> &middot; <a href="<?=$user->getURI()?>">View your profile</a></div>
    </div>
  </div>

<? if ($model->error === UpdateModel::ERROR_INTERNAL) { ?>
