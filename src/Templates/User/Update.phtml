            <input class="<?=$input_class . $field_invalid('username')?>" type="text" name="username" id="username" required autocomplete="username" maxlength="<?=$model->username_max_len?>" value="<?=$esc($model->username)?>"/>
            <?=$field_error('username')?>
          </div>
          <div class="form-group">
            <label class="font-weight-bold" for="display_name">Display name:<span class="ml-2 small text-muted">(shown around the site, your username if blank)</span></label>
            <input class="<?=$input_class . $field_invalid('display_name')?>" type="text" name="display_name" id="display_name" autocomplete="nickname" maxlength="<?=$model->display_name_max_len?>" placeholder="<?=$esc($user->getUsername())?>" value="<?=$esc($model->display_name)?>"/>
            <?=$field_error('display_name')?>
          </div>
          <div class="form-group">
            <label class="font-weight-bold" for="email">Email address:<span class="ml-2 small text-muted">(private, used to log in and for your avatar)</span></label>
            <input class="<?=$input_class . $field_invalid('email')?>" type="email" name="email" id="email" required autocomplete="email" maxlength="<?=$model->email_max_len?>" value="<?=$esc($model->email)?>" data-original="<?=$esc($user->getEmail())?>"/>
