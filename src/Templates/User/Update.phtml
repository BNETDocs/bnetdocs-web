$field_errors = [
  'username' => [
    'EMPTY' => 'Your username cannot be blank.',
    'TAKEN' => 'That username is already in use by another account.',
    'TOO_LONG' => sprintf('Your username must be at most %d characters.', $model->username_max_len),
    'TOO_SHORT' => sprintf('Your username must be at least %d characters.', $model->username_min_len),
  ],
  'display_name' => [
    'TOO_LONG' => sprintf('Your display name must be at most %d characters.', $model->display_name_max_len),
  ],
  'email' => [
    'EMPTY' => 'Your email address cannot be blank.',
    'INVALID' => 'Your new email address is not formatted correctly.',
