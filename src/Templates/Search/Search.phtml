<?php /* vim: set colorcolumn= expandtab shiftwidth=2 softtabstop=2 tabstop=4 smarttab: */
namespace BNETDocs\Templates\Search;

use \BNETDocs\Libraries\Comment;
use \BNETDocs\Libraries\Core\UrlFormatter;
use \BNETDocs\Libraries\Document;
use \BNETDocs\Libraries\News\Post as NewsPost;
use \BNETDocs\Libraries\Packet\Packet;
use \BNETDocs\Libraries\Search\Results;
use \BNETDocs\Libraries\Server\Server;
use \BNETDocs\Libraries\User\User;

$results = $this->getContext()->results;
$user_input = trim($this->getContext()->user_input ?? '');
$title = (empty($user_input) ? 'Search' : 'Search: ' . $user_input);
$description = 'Search documents, packets, news posts, servers, users, and comments on BNETDocs.';
$_header_stylesheets = ['search.css'];

$e = fn(?string $value): string => filter_var($value ?? '', FILTER_SANITIZE_FULL_SPECIAL_CHARS);
$snippet = fn(?string $value): string => $e(mb_strimwidth(trim(preg_replace('/\s+/', ' ', html_entity_decode(strip_tags($value ?? ''), ENT_QUOTES | ENT_HTML5, 'UTF-8'))), 0, 200, '…'));

// Number of results shown per section before the remainder is tucked behind a "Show all" toggle.
$preview_count = 5;

$sections = [];
if ($results instanceof Results && !$results->isEmpty())
{
  $sections = [
    ['documents', 'Documents', $results->getDocuments() ?? []],
    ['packets', 'Packets', $results->getPackets() ?? []],
    ['news', 'News posts', $results->getNewsPosts() ?? []],
    ['servers', 'Servers', $results->getServers() ?? []],
    ['users', 'Users', $results->getUsers() ?? []],
    ['comments', 'Comments', $results->getComments() ?? []],
  ];
  $sections = array_values(array_filter($sections, fn(array $section): bool => !empty($section[2])));
}
$total = array_sum(array_map(fn(array $section): int => count($section[2]), $sections));

/**
 * Normalizes a search result into [title html, subtitle html, preview html, href, tags].
 */
$describe = function (object $item) use ($e, $snippet): array
{
  switch (true)
  {
    case $item instanceof Document:
      return [$e($item->getTitle()), '', $snippet($item->getBrief(true) ?: $item->getContent(true)), $item->getURI(), $item->getTags()];
    case $item instanceof NewsPost:
      return [$e($item->getTitle()), $e($item->getPublishedDateTime()->format('M j, Y')), $snippet($item->getContent(true)), $item->getURI(), $item->getTags()];
    case $item instanceof Packet:
      return ['<code>' . $e($item->getName()) . '</code>', $e($item->getPacketId(true) . ' · ' . $item->getDirectionLabel()), $snippet($item->getRemarks(true)), $item->getURI(), $item->getTags()];
    case $item instanceof Server:
      return [$e($item->getName()), '<code>' . $e($item->getAddress() . ':' . $item->getPort()) . '</code>', '', $item->getURI(), $item->getTags()];
    case $item instanceof User:
      return [$e($item->getName()), $e('Member for ' . $item->getCreatedEstimate()), '', $item->getURI(), $item->getTags()];
    case $item instanceof Comment:
      $author = $item->getUser();
      return [
        $e($author ? $author->getName() : 'Anonymous'),
        $e($item->getCreatedDateTime()->format('M j, Y')),
        $snippet($item->getContent(true)),
        $item->getParentUrl(),
        [],
      ];
    default:
      return [$e('ID ' . $item->getId()), '', '', '#', []];
  }
};

$render_item = function (object $item) use ($describe, $e): void
{
  [$item_title, $item_sub, $item_preview, $item_href, $item_tags] = $describe($item);
  echo '<li><a class="search-result" href="' . $item_href . '">';
  echo '<span class="search-result-head"><span class="search-result-title">' . $item_title . '</span>';
  if ($item_sub) echo '<span class="search-result-sub">' . $item_sub . '</span>';
  echo '</span>';
  if ($item_preview) echo '<span class="search-result-preview">' . $item_preview . '</span>';
  if (!empty($item_tags))
  {
    echo '<span class="search-result-tags">';
    foreach ($item_tags as $tag) echo '<span class="badge badge-secondary">' . $e($tag->getTagString()) . '</span> ';
    echo '</span>';
  }
  echo '</a></li>' . PHP_EOL;
};

require('./Includes/header.inc.phtml'); ?>
<div class="container search-page">
  <h1 class="h2 mt-2 mb-3"><?=(empty($user_input) ? 'Search BNETDocs' : 'Search results')?></h1>
  <form class="search-form mb-3" action="<?=UrlFormatter::format('/search')?>" method="GET" role="search">
    <input class="form-control bg-dark border-secondary text-light" type="search" name="q" value="<?=$e($user_input)?>" placeholder="Packet name, document title, server, user…" aria-label="Search query"<?=(empty($user_input) ? ' autofocus' : '')?>/>
    <button class="btn btn-primary" type="submit">Search</button>
  </form>
<? if (empty($user_input)) { ?>
  <p class="text-muted">Search documents, packets, news posts, servers, users, and comments.</p>
<? } else if (empty($sections)) { ?>
  <div class="search-empty">
    <p class="mb-1">No results for <strong><?=$e($user_input)?></strong>.</p>
    <p class="mb-0 text-muted">Try a shorter or different term, or browse
      <a href="<?=UrlFormatter::format('/document/index')?>">documents</a>,
      <a href="<?=UrlFormatter::format('/packet/index')?>">packets</a>, or
      <a href="<?=UrlFormatter::format('/servers')?>">servers</a>.</p>
  </div>
<? } else { ?>
  <p class="text-muted mb-2"><?=number_format($total)?> result<?=($total === 1 ? '' : 's')?> for <strong class="text-light"><?=$e($user_input)?></strong></p>
<?  if (count($sections) > 1) { ?>
  <nav class="search-jump mb-3" aria-label="Result types">
<?    foreach ($sections as [$anchor, $label, $items]) { ?>
    <a class="badge badge-pill badge-dark" href="#<?=$anchor?>"><?=$label?> <span class="text-muted"><?=number_format(count($items))?></span></a>
<?    } ?>
  </nav>
<?  } ?>
<?  foreach ($sections as [$anchor, $label, $items]) {
      $items = array_values($items); ?>
  <section class="search-section" id="<?=$anchor?>">
    <h2 class="search-section-title"><?=$label?> <span class="badge badge-secondary"><?=number_format(count($items))?></span></h2>
    <ul class="search-results">
<?    foreach (array_slice($items, 0, $preview_count) as $item) $render_item($item); ?>
    </ul>
<?    if (count($items) > $preview_count) { ?>
    <details class="search-more">
      <summary>Show all <?=number_format(count($items))?> <?=strtolower($label)?></summary>
      <ul class="search-results">
<?      foreach (array_slice($items, $preview_count) as $item) $render_item($item); ?>
      </ul>
    </details>
<?    } ?>
  </section>
<?  } ?>
<? } ?>
</div>
<? require('./Includes/footer.inc.phtml'); ?>
