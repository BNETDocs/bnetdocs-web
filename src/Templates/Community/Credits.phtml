<?php /* vim: set colorcolumn= expandtab shiftwidth=2 softtabstop=2 tabstop=4 smarttab: */
namespace BNETDocs\Templates\Community;
use \BNETDocs\Libraries\User\User;
$title = 'Contributors';
$description = 'The top contributors to BNETDocs grouped by different types of content.';
$url = '/credits';
$_header_stylesheets = ['credits.css'];

$e = fn(?string $value): string => filter_var($value ?? '', FILTER_SANITIZE_FULL_SPECIAL_CHARS);

$total_users = $this->getContext()->total_users;
$boards = [
  ['Packets', 'packet', 'packets', $this->getContext()->top_contributors_by_packets],
  ['Documents', 'document', 'documents', $this->getContext()->top_contributors_by_documents],
  ['Comments', 'comment', 'comments', $this->getContext()->top_contributors_by_comments],
  ['News posts', 'post', 'posts', $this->getContext()->top_contributors_by_news_posts],
  ['Servers', 'server', 'servers', $this->getContext()->top_contributors_by_servers],
];
$users = []; // User object lookup cache, since the same people top several boards

require('./Includes/header.inc.phtml'); ?>
<div class="container">
  <h1><?=$title?></h1>
  <p class="text-muted">The people who built BNETDocs. Of our <strong class="text-light"><?=number_format((int) $total_users)?> registered users</strong>, these are the top contributors for each kind of content.</p>

  <div class="credits-grid">
<? foreach ($boards as [$board_title, $singular, $plural, $rows]) {
     $rows = is_array($rows) ? $rows : [];
     $leader = empty($rows) ? 0 : max(array_map(fn(object $row): int => (int) $row->count, $rows)); ?>
    <section class="credits-board">
      <h2 class="credits-board-title"><?=$board_title?></h2>
<?   if (empty($rows)) { ?>
      <p class="text-muted mb-0">No <?=$plural?> yet.</p>
<?   } else { ?>
      <ol class="credits-list">
<?     foreach ($rows as $i => $row) {
         $count = (int) $row->count;
         $percent = $leader > 0 ? max(4, round($count / $leader * 100)) : 0;
         $user = null;
         if (!is_null($row->user_id))
         {
           $user = $users[$row->user_id] ?? null;
           if (!$user) $users[$row->user_id] = $user = new User($row->user_id);
         } ?>
        <li class="credits-row<?=($i === 0 ? ' is-leader' : '')?>">
          <span class="credits-rank"><?=($i + 1)?></span>
<?       if ($user) { ?>
          <a class="credits-who" href="<?=$user->getURI()?>"><img src="<?=$user->getAvatarURI(56)?>" width="28" height="28" alt=""/><span><?=$e($row->name)?></span></a>
<?       } else { ?>
          <span class="credits-who"><span class="credits-anon" aria-hidden="true">?</span><span><?=$e($row->name)?></span></span>
<?       } ?>
          <span class="credits-count"><?=number_format($count)?> <span class="text-muted"><?=($count === 1 ? $singular : $plural)?></span></span>
          <span class="credits-bar" style="width:<?=$percent?>%" aria-hidden="true"></span>
        </li>
<?     } ?>
      </ol>
<?   } ?>
    </section>
<? } ?>
  </div>
</div>
<? require('./Includes/footer.inc.phtml'); ?>
